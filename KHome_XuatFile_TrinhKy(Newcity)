Sub XuatFile_TrinhKy()
    Dim wsSetup As Worksheet, wsTrinhKy As Worksheet
    Dim sheetNameTrinhKy As String
    Dim lastRow As Long, maxCol As Long
    Dim newWb As Workbook, newWs As Worksheet
    Dim copyRange As Range
    Dim dotCanLoc As String
    Dim folderPath As String, fullPath As String
    Dim defaultName As String, customName As String
    Dim searchRange As Range
    
    On Error Resume Next
    Set wsSetup = ThisWorkbook.Sheets("Setup")
    sheetNameTrinhKy = Trim(wsSetup.Range("J2").Value)
    Set wsTrinhKy = ThisWorkbook.Sheets(sheetNameTrinhKy)
    On Error GoTo 0
    
    If wsTrinhKy Is Nothing Then
        ' Khong dung tieng Viet co dau cung duoc vi code VBE bi loi font
        MsgBoxUni "Loi: Khong tim thay sheet Trinh Ky!", vbCritical, "Loi"
        Exit Sub
    End If
    
    ' --- 1. XU LY DUONG DAN ---
    folderPath = Trim(wsSetup.Range("M1").Value)
    Dim pathExists As Boolean: pathExists = False
    
    If folderPath <> "" Then
        On Error Resume Next
        If Dir(folderPath, vbDirectory) <> "" Then pathExists = True
        On Error GoTo 0
    End If
    
    If pathExists = False Then
        If folderPath <> "" Then
            MsgBoxUni "Duong dan hien tai da bi xoa! Vui long chon lai.", vbExclamation, "Chu y"
        End If
        
        With Application.FileDialog(msoFileDialogFolderPicker)
            .Title = "Chon thu muc luu File"
            If .Show = -1 Then
                folderPath = .SelectedItems(1)
                wsSetup.Range("M1").Value = folderPath
            Else
                Exit Sub
            End If
        End With
    End If
    If Right(folderPath, 1) <> "\" Then folderPath = folderPath & "\"
    
    ' --- 2. XAC DINH VUNG DU LIEU ---
    Set searchRange = wsTrinhKy.Cells.Find(What:="*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious)
    If searchRange Is Nothing Then Exit Sub Else lastRow = searchRange.row
    Set searchRange = wsTrinhKy.Cells.Find(What:="*", SearchOrder:=xlByColumns, SearchDirection:=xlPrevious)
    If searchRange Is Nothing Then maxCol = 1 Else maxCol = searchRange.Column
    
    If lastRow < 2 Then Exit Sub
    Set copyRange = wsTrinhKy.Range(wsTrinhKy.Cells(2, 1), wsTrinhKy.Cells(lastRow, maxCol))
    
    ' --- 3. GOI USERFORM CHON TEN BANG TIENG VIET ---
    frmChonTen.Show
    
    If frmChonTen.DaHuy Then
        Unload frmChonTen
        MsgBoxUni "Ban da huy xuat file!", vbInformation, "Thong bao"
        Exit Sub
    End If
    
    customName = frmChonTen.TenDuocChon
    Unload frmChonTen
    
    ' --- 4. COPY VA TAO FILE MOI ---
    Application.ScreenUpdating = False
    Set newWb = Workbooks.Add
    Set newWs = newWb.Sheets(1)
    
    copyRange.Copy
    With newWs.Range("A1")
        .PasteSpecial Paste:=xlPasteColumnWidths
        .PasteSpecial Paste:=xlPasteFormats
        .PasteSpecial Paste:=xlPasteValuesAndNumberFormats
    End With
    Application.CutCopyMode = False
    newWs.Range("A1").Select
    
    ' --- 5. LUU FILE ---
    dotCanLoc = Trim(wsTrinhKy.Range("F1").Value)
    
    ' T?o ch? "Ð?t" b?ng mã Unicode chu?n d? không bao gi? b? l?i font
    Dim chuDot As String
    chuDot = ChrW(272) & ChrW(7906) & "T"
    
    If customName <> "" Then
        defaultName = customName & " - " & chuDot & " " & dotCanLoc & " - " & Format(Now, "yyyymmdd_HHmmss") & ".xlsx"
    Else
        defaultName = "BaoCao_" & sheetNameTrinhKy & "_" & chuDot & " " & dotCanLoc & "_" & Format(Now, "yyyymmdd_HHmmss") & ".xlsx"
    End If
    
    ' Ch?ng l?i ký t? d?c bi?t
    Dim invalidChars As Variant, chr As Variant
    invalidChars = Array("/", "\", ":", "*", "?", "<", ">", "|")
    For Each chr In invalidChars
        defaultName = Replace(defaultName, chr, "-")
    Next chr
    
    fullPath = folderPath & defaultName
    
    Application.DisplayAlerts = False
    newWb.SaveAs fileName:=fullPath, FileFormat:=xlOpenXMLWorkbook
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    ' T?n d?ng hàm MsgBoxUni c?a b?n d? show du?ng d?n ch?a Ti?ng Vi?t mu?t mà!
    MsgBoxUni "Xuat file thanh cong!" & vbCrLf & fullPath, vbInformation, "Thanh cong"
End Sub
